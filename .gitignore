.venv/
__pycache__/
*.pyc

# Données générées à l'exécution : conversations et questions des utilisateurs.
# Ne doivent jamais être committées.
.chatpy_history.json
questions_sans_reponse.json
conversations.json
comptes.json
comptes.json.repris
.env

# Base SQLite des comptes (schema.sql, lui, est committé). Les fichiers -wal et
# -shm sont les journaux du mode WAL, créés à côté de la base.
chatpy.db
chatpy.db-wal
chatpy.db-shm

# Export de la base : contient de vraies adresses email.
export_comptes.csv

# Écriture atomique et mise de côté des fichiers illisibles.
.tmp_chatpy_*.json
*.corrompu

# Photos de profil uploadées par les utilisateurs.
avatars/

